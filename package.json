{
  "name": "maestro",
  "version": "0.1.0",
  "private": true,
  "description": "Maestro — voice-driven operations copilot for luxury hotel general managers",
  "workspaces": [
    "apps/*",
    "mcp-servers/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx watch apps/orchestrator/src/index.ts",
    "dev:offline": "OFFLINE_MODE=1 tsx watch apps/orchestrator/src/index.ts",
    "dev:dashboard": "npm --workspace @maestro/dashboard run dev",
    "kill-ghosts": "pkill -f 'mcp-servers/.*src/index' || true",
    "warm-cache": "./scripts/keep-cache-warm.sh",
    "typecheck": "tsc --noEmit -p tsconfig.base.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
